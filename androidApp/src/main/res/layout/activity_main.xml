<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020613">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORBIT / PHONE BRIDGE"
            android:textColor="#66D8FF"
            android:textSize="12sp"
            android:letterSpacing="0.14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calendar for your glasses"
            android:textColor="#F8FBFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#AAB9CF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Allow calendar access" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refresh from DAVx5 calendars" />

        <Button
            android:id="@+id/connectGlassesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Connect Meta display glasses" />

        <TextView
            android:id="@+id/eventsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="#F8FBFF"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DAVx5 stays logged in and syncs the phone calendar. Orbit only reads Android's shared Calendar Provider. The glasses bridge is intentionally isolated behind a small interface so the Meta Wearables SDK can be added without moving calendar credentials into this app."
            android:textColor="#AAB9CF"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
